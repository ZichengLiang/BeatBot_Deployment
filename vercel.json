{
  "version": 2,
  "buildCommand": "cd frontend && npm install && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "env": {
    "REACT_APP_API_URL": ""
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "http://beatbox-alb-1156795421.eu-west-1.elb.amazonaws.com/api/:match*"
    },
    {
      "source": "/carbonTracker",
      "destination": "http://beatbox-alb-1156795421.eu-west-1.elb.amazonaws.com/carbonTracker"
    }
  ]
}
